rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /homework/{homeworkId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // tighten later: check users/{uid}.role in {'admin','teacher'} via Firestore if needed
    }
    match /students/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
